############################################
# ATHUL P SUDHEER – LOOK & FEEL v2
# Clean • Focused • Professional
############################################

general {
    border_size = 1

    # Layout spacing
    gaps_in = 3
    gaps_out = 4    # Accent borders (Crimson active, Wine inactive)
    col.active_border = rgba(FF205Eee)
    col.inactive_border = rgba(6D0E41aa)

    layout = dwindle
}

############################################
# DECORATION
############################################

decoration {

    # Modern rounding
    rounding = 0
    rounding_power = 3

    # Subtle inactive contrast
    active_opacity = 1.0
    inactive_opacity = 0.95
    fullscreen_opacity = 1.0

    dim_inactive = false

    ########################################
    # BLUR – subtle glass, not gamer
    ########################################
    blur {
        enabled = true
        size = 6
        passes = 2
        ignore_opacity = true
        new_optimizations = true

        noise = 0.02
        contrast = 0.9
        brightness = 0.9
        vibrancy = 0.1
    }

    ########################################
    # SHADOW – soft depth
    ########################################
    shadow {
        enabled = true
        range = 10
        render_power = 3
        ignore_window = true
        color = rgba(00000055)
    }
}

############################################
# ANIMATIONS – Minimal & Professional
############################################

animations {
    enabled = true

    # Ultra-fast curves for a "snappy" industrial feel
    bezier = quick, 0.05, 0.9, 0.1, 1.0

    # Popin 95% makes the window appear almost instantly with a tiny 'settle'
    animation = windows, 1, 2, quick, popin 95%
    
    # Near-instant color switching for borders
    animation = border, 1, 1, default
    
    # Fast fade to keep focus transitions clean
    animation = fade, 1, 2, default
    
    # High-speed workspace sliding to maintain workflow momentum
    animation = workspaces, 1, 3, quick, slide
}

############################################
# MISC CLEANUP
############################################

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    background_color = 0x00224D
    
    # Focus behavior for a professional workflow
    force_default_wallpaper = 0
    vfr = true
}

############################################
# DWINDLE LAYOUT (Balanced)
############################################

dwindle {
    pseudotile = true
    preserve_split = true
}
